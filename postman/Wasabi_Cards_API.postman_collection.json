              }
            ],
            "url": "{{base_url}}/api/v1/cards/cardholders"
          }
        }
      ]
    },
    {
      "name": "17 Cardholder - Update (Resubmit After Rejection)",
      "item": [
        {
          "name": "PUT /api/v1/cards/cardholder/{holder_id}",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotency_key}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cardHolderModel\": \"B2C\",\n  \"cardTypeId\": 111078,\n  \"areaCode\": \"+254\",\n  \"mobile\": \"712345678\",\n  \"email\": \"user@example.com\",\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Doe\",\n  \"birthday\": \"1990-01-01\",\n  \"nationality\": \"KE\",\n  \"country\": \"KE\",\n  \"town\": \"Nairobi\",\n  \"address\": \"1 Main St\",\n  \"postCode\": \"00100\",\n  \"gender\": \"F\",\n  \"idType\": \"DLN\",\n  \"idNumber\": \"CORRECTED-ID-NUMBER\",\n  \"issueDate\": \"2020-01-01\",\n  \"idNoExpiryDate\": \"2030-01-01\",\n  \"idFrontId\": \"file-id-front\",\n  \"idBackId\": \"file-id-back\",\n  \"idHoldId\": \"file-id-selfie\"\n}"
            },
            "url": "{{base_url}}/api/v1/cards/cardholder/{{holder_id}}",
            "description": "Wasabi v2 cardholder update. Only works when the holder status is 'reject' - correct the details and resubmit. Returns 409 otherwise."
          }
        }
      ]
    },
    {
      "name": "18 KYC - Submit Work Ticket",
      "item": [
        {
          "name": "POST /api/v1/cards/kyc/submit",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotency_key}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Activate my card\",\n  \"target\": \"card_activation\",\n  \"tradeType\": \"CARD_ACTIVE\",\n  \"content\": \"Please activate my virtual card after KYC approval.\",\n  \"cardNo\": \"\"\n}"
            },
            "url": "{{base_url}}/api/v1/cards/kyc/submit",
            "description": "Escalation path when a cardholder is stuck in wait_audit. Creates a ticket in Wasabi's queue. You get a 'work' webhook with tradeStatus when it resolves."
          }
        }
      ]
    },
    {
      "name": "19 Card - Create (KYC Phase 2)",
      "item": [
        {
          "name": "POST /api/v1/cards/create",
          "request": {
            "method": "POST",
            "header": [
