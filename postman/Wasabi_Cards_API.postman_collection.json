            },
            "url": "{{base_url}}/api/v1/cards/create",
            "description": "Create and fund a virtual card. Requires an approved holder. Save cardNo as {{card_no}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
