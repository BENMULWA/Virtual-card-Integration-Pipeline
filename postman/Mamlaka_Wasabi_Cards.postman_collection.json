    {
      "name": "5 - Local callback simulation (no money, simulates providers calling YOU)",
      "description": "",
      "item": [
        {
          "name": "Simulate Wasabi webhook: card_holder",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-WSB-CATEGORY",
                "value": "card_holder"
              },
              {
                "key": "X-WSB-REQUEST-ID",
                "value": "{{$guid}}"
              },
              {
                "key": "X-WSB-SIGNATURE",
                "value": "invalid-on-purpose"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/webhooks/wasabi",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "webhooks",
                "wasabi"
              ]
            },
            "description": "Add headers X-WSB-CATEGORY=card_holder and X-WSB-REQUEST-ID=<unique>. Returns 401 while ENABLE_WEBHOOK_SIGNATURE_VALIDATION=true (the real signature can't be forged here). The handler re-reads state from Wasabi; it never trusts this body.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"holderId\": \"{{holder_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Simulate M-Pesa callback",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
